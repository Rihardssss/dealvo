# Ports, uz kura darbojas serveris
PORT=3000
# Ja iestatīts, datus (skenēt / demo / dzēst) var mainīt tikai ar šo paroli. Obligāti publiskajā versijā.
ADMIN_TOKEN=
# Claude API atslēga AI asistentam (https://console.anthropic.com). Bez tās asistents strādā bezsaistes režīmā.
ANTHROPIC_API_KEY=
# Pēc izvēles: cits Claude modelis
ANTHROPIC_MODEL=claude-haiku-5-5
# Automātiskā skenēšana (0 = izslēgta)
AUTO_SCAN=1
# Cik bieži skenē nākamo marku (minūtes)
AUTO_SCAN_MINUTES=10
# Pēc cik minūtēm markas dati uzskatāmi par veciem
AUTO_SCAN_STALE_MINUTES=60
# Kuras vietnes skenēt automātiski (mobile.de parasti bloķē)
AUTO_SCAN_SOURCES=sslv,autoscout24

# ss.lv bloķē datu centru IP adreses. Uz servera ss.lv lasa caur Cloudflare Worker (deploy/cloudflare-worker.js)
# SCRAPE_PROXY=https://dealvo-sslv.TAVS-KONTS.workers.dev
# SCRAPE_PROXY_KEY=gara-nejauša-parole
