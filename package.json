{
  "name": "dealvo",
  "version": "1.0.0",
  "description": "Dealvo — savāc auto sludinājumus no vairākiem avotiem un atrod labākos piedāvājumus",
  "main": "src/server.js",
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o public/app.css --minify",
    "watch:css": "tailwindcss -i src/styles.css -o public/app.css --watch",
    "prestart": "npm run build:css",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "npm run build:css && node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test test/*.test.js"
  },
  "author": "Rihards Indars",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
